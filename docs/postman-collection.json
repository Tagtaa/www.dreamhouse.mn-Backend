            "body": {
              "mode": "raw",
              "raw": "{\n  \"smsContent\": \"500₮ received from Khan Bank. Note: +97612345678\",\n  \"phoneNumber\": \"+97612345678\",\n  \"amount\": 500,\n  \"bankName\": \"Khan Bank\",\n  \"transactionNote\": \"+97612345678\",\n  \"smsTimestamp\": \"2024-01-20T10:30:00Z\",\n  \"parserAppVersion\": \"1.0.0\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/sms-parser/bank-transaction",
              "host": ["{{base_url}}"],
              "path": ["sms-parser", "bank-transaction"]
            }
          }
        },
        {
          "name": "Get Response Statistics",
          "request": {
            "header": [
              {
                "key": "X-SMS-Parser-API-Key",
                "value": "{{sms_parser_api_key}}"
              }
            ],
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sms-parser/responses/stats?endpoint=verify-otp&startDate=2024-01-20&endDate=2024-01-21",
              "host": ["{{base_url}}"],
              "path": ["sms-parser", "responses", "stats"],
              "query": [
                {
                  "key": "endpoint",
                  "value": "verify-otp"
                },
                {
                  "key": "startDate",
                  "value": "2024-01-20"
                },
                {
                  "key": "endDate",
                  "value": "2024-01-21"
                }
              ]
            }
          }
        },
        {
          "name": "Get Error Summary",
          "request": {
            "header": [
              {
                "key": "X-SMS-Parser-API-Key",
                "value": "{{sms_parser_api_key}}"
              }
            ],
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sms-parser/responses/errors?days=7",
              "host": ["{{base_url}}"],
              "path": ["sms-parser", "responses", "errors"],
              "query": [
                {
                  "key": "days",
                  "value": "7"
                }
              ]
            }
          }
        },
        {
          "name": "Get Responses",
          "request": {
            "header": [
              {
                "key": "X-SMS-Parser-API-Key",
                "value": "{{sms_parser_api_key}}"
              }
            ],
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sms-parser/responses?page=1&limit=20&endpoint=verify-otp",
              "host": ["{{base_url}}"],
              "path": ["sms-parser", "responses"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "endpoint",
                  "value": "verify-otp"
                }
              ]
            }
          }
        },
        {
          "name": "Cleanup Old Responses",
          "request": {
            "header": [
              {
                "key": "X-SMS-Parser-API-Key",
                "value": "{{sms_parser_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 30\n}"
            },
            "url": {
              "raw": "{{base_url}}/sms-parser/responses/cleanup",
              "host": ["{{base_url}}"],
              "path": ["sms-parser", "responses", "cleanup"]
            }
          }
        },
        {
          "name": "Clear All Responses",
          "request": {
            "header": [
              {
