            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/sms-parser/responses/cleanup",
              "host": ["{{base_url}}"],
              "path": ["sms-parser", "responses", "cleanup"]
            }
          }
        }
