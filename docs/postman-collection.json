              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+97612345678\",\n  \"otpCode\": \"84739\",\n  \"smsContent\": \"84739\",\n  \"smsTimestamp\": \"2024-01-20T10:30:00Z\",\n  \"parserAppVersion\": \"1.0.0\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/sms-parser/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["sms-parser", "verify-otp"]
